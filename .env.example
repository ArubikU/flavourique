# ============================================
# Flavorique - Variables de Entorno
# ============================================
# Copiar este archivo a .env y configurar los valores

# Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flavorique
DB_USER=flavorique_user
DB_PASSWORD=flavorique_secret

# JWT
JWT_SECRET=tu-clave-secreta-muy-larga-y-segura-cambiar-en-produccion
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Spring
SPRING_PROFILES_ACTIVE=dev

# Frontend
FRONTEND_URL=http://localhost:4200
