# Environment variables for Flavorique Backend

# JWT Configuration
JWT_SECRET=flavorique-super-secret-key-for-jwt-token-generation-minimum-256-bits-change-this-in-production

# Database Configuration (Production)
DB_URL=jdbc:postgresql://localhost:5432/flavorique
DB_USERNAME=flavorique_user
DB_PASSWORD=flavorique_secret

# Server Configuration
SERVER_PORT=8080
